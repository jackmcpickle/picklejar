# Picklejar - AI Coding Agent Orchestration
# Copy this to .env and fill in your API keys

# Required for default coordinator + discovery agents
ANTHROPIC_API_KEY=

# Required for default implementation agents
OPENAI_API_KEY=

# Optional providers
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama (no key needed, just ensure server is running)
# OLLAMA_BASE_URL=http://localhost:11434
