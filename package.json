{
    "name": "picklejar",
    "version": "0.1.0",
    "description": "AI coding agent orchestration tool powered by Mastra AI",
    "license": "MIT",
    "bin": {
        "picklejar": "./dist/cli.mjs"
    },
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "imports": {
        "#config/*.js": "./src/config/*.js",
        "#tools/*.js": "./src/tools/*.js",
        "#tasks/*.js": "./src/tasks/*.js",
        "#worktree/*.js": "./src/worktree/*.js"
    },
    "scripts": {
        "prepare": "husky",
        "dev": "mastra dev",
        "build": "tsdown",
        "start": "node dist/cli.mjs start",
        "test": "vitest",
        "typecheck": "oxlint --type-aware --type-check",
        "lint": "oxlint --type-aware --type-check --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.64",
        "@ai-sdk/google": "latest",
        "@ai-sdk/openai": "^3.0.48",
        "@mastra/core": "^1.17.0",
        "@mastra/libsql": "latest",
        "@mastra/memory": "^1.10.0",
        "commander": "^14.0.3",
        "execa": "^9.6.1",
        "fast-glob": "^3.3.3",
        "mastra": "^1.3.15",
        "picocolors": "^1.1.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "oxfmt": "^0.42.0",
        "oxlint": "^1.57.0",
        "oxlint-tsgolint": "^0.18.1",
        "tsdown": "^0.21.6",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx,json,css,scss,md,mdx,yml,yaml}": "oxfmt --write --no-error-on-unmatched-pattern",
        "src/**/*.{js,jsx,ts,tsx}": "oxlint --type-aware --type-check --fix --quiet"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
