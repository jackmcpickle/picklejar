{
  "name": "picklejar",
  "version": "0.1.0",
  "description": "AI coding agent orchestration tool powered by Mastra AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "picklejar": "./dist/cli.js"
  },
  "scripts": {
    "dev": "mastra dev",
